<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone on purpose: no parent pom, no shared code with anything
       else. `cd fitko-spring && mvn package` works on its own. -->
  <groupId>com.gfi.ozg.fitko</groupId>
  <artifactId>fitko-spring</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>fitko-spring</name>
  <description>
    Spring Boot auto-configuration for the FIT-Connect Java SDK: sending
    Anträge via an injectable AntragSender bean, and receiving them as Spring
    application events, all configured through regular
    application.properties/application.yml.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Boot 4 requires Java 17+. -->
    <maven.compiler.release>17</maven.compiler.release>

    <!-- see https://central.sonatype.com/artifact/dev.fitko.fitconnect.sdk/client
         and https://docs.fitko.de/fit-connect/docs/sdks/java-sdk/changelog for newer releases -->
    <fitconnect-sdk.version>3.5.0</fitconnect-sdk.version>
    <!-- see https://github.com/spring-projects/spring-boot/releases for newer releases -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- Matches spring-boot-dependencies' own managed lombok.version; kept
         explicit here too since annotationProcessorPaths below needs one. -->
    <lombok.version>1.18.46</lombok.version>

    <!-- Optional, opt-in multi-replica poll coordination. Not managed by
         spring-boot-dependencies, so pinned here. 7.x targets JDK 17 (this
         module's baseline); the net.javacrumbs.shedlock.core LockProvider /
         LockConfiguration(Instant, String, Duration, Duration) / SimpleLock
         API used here has been stable across ShedLock 4-7.
         See https://github.com/lukas-krecan/ShedLock/releases for newer releases -->
    <shedlock.version>7.9.0</shedlock.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.fitko.fitconnect.sdk</groupId>
      <artifactId>client</artifactId>
      <version>${fitconnect-sdk.version}</version>
    </dependency>

    <!-- Compile-time only (annotation processor): generates the getters/
         setters/constructors this starter's classes declare via annotations
         instead of by hand. Not needed at runtime - Lombok's output is plain
         bytecode - so it's optional and never propagated to consumers. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- Optional: observability for the receive pipeline (see
         FitConnectReceiveMetricsAutoConfiguration /
         FitConnectReceiveHealthAutoConfiguration). Both are @ConditionalOnClass
         gated, so a consumer that doesn't already run Micrometer/Actuator pulls
         in neither jar and simply gets no meters / no health contributor.
         micrometer-core gives us MeterRegistry; spring-boot-health gives us
         the HealthIndicator/Health API (Boot 4 split it out of
         spring-boot-actuator) plus @ConditionalOnEnabledHealthIndicator - the
         consuming application's own actuator setup is what actually exposes
         the endpoint. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Optional: only needed for fitconnect.receiver.callback.enabled=true
         (the webhook endpoint). Not propagated to consumers (optional=true)
         so a polling-only application never pulls in a servlet container -
         FitConnectCallbackAutoConfiguration itself is @ConditionalOnClass
         gated and simply doesn't activate without it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Optional: opt-in multi-replica poll coordination
         (fitconnect.receiver.polling.distributed-lock). Active only when the
         consumer puts shedlock-core on their classpath AND declares a
         net.javacrumbs.shedlock.core.LockProvider bean (JDBC/Redis/Mongo/...).
         FitConnectPollLockAutoConfiguration is @ConditionalOnClass(LockProvider)
         gated, so a consumer that doesn't want it pulls in nothing and sees no
         behaviour change. shedlock-core's only runtime transitive dependency is
         slf4j-api, already present; shedlock-spring (the @SchedulerLock AOP
         path) is deliberately not used - this drives the programmatic
         LockProvider API directly from the poller's own scheduler. -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-core</artifactId>
      <version>${shedlock.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Optional: opt-in fleet-wide receive metrics
         (fitconnect.receiver.shared-metrics.enabled=true). Just the API type
         (StringRedisTemplate) so FitConnectReceiveSharedMetricsAutoConfiguration
         can be @ConditionalOnClass-gated and compile; the consumer brings the
         actual Redis driver via spring-boot-starter-data-redis and configures
         spring.data.redis.*. Not propagated (optional=true), so a consumer
         that doesn't opt in pulls in no Redis client and sees no change. -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Generates META-INF/spring-configuration-metadata.json from the
         @ConfigurationProperties javadoc, so fitconnect.* keys get IDE
         autocomplete/descriptions in a consuming application. Compile-time
         only: not needed at runtime by consumers of this starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- MockMvc support for FitConnectCallbackControllerTest - split out of
         spring-boot-starter-test in Boot 4's modularized web testing setup. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <!-- Explicit instead of relying on classpath auto-discovery, which
               isn't reliable across javac versions: this is what actually
               makes spring-boot-configuration-processor generate
               META-INF/spring-configuration-metadata.json - and, since
               specifying any path switches javac to explicit-processor mode,
               what makes Lombok run at all. Lombok listed first: it has to
               generate the real getters/setters before
               spring-boot-configuration-processor reads them back out
               (which it supports natively - Lombok-annotated fields' javadoc
               still becomes each property's description). -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
