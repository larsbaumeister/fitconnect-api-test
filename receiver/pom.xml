<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gfi.ozg.fitko</groupId>
    <artifactId>fitconnect-samples</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>fitconnect-receiver-sample</artifactId>
  <packaging>jar</packaging>

  <name>FIT-Connect Samples - Receiver</name>
  <description>
    Standalone command-line "Verwaltungssystem" sample that polls a
    FIT-Connect destination for submissions, decrypts and persists them to
    disk, and optionally accepts or rejects them using the FIT-Connect Java
    SDK.
  </description>

  <properties>
    <exec.mainClass>com.gfi.ozg.fitko.receiver.ReceiverApp</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.gfi.ozg.fitko</groupId>
      <artifactId>fitconnect-samples-common</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.fitko.fitconnect.sdk</groupId>
      <artifactId>client</artifactId>
    </dependency>
    <!-- Used to dump the full decrypted submission (incl. metadata) as JSON;
         already a transitive dependency of the SDK, declared explicitly here
         because ReceivedSubmissionWriter calls the Jackson API directly. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <!-- Console binding for the SDK's SLF4J log output (retries, warnings, ...). -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>fitconnect-receiver-sample</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${exec.mainClass}</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
