<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_fitconnect_poll"
                  targetNamespace="http://gfi.com/ozg/fitko/camunda"
                  exporter="hand-written" exporterVersion="1.0">

  <!-- Dispatcher: runs on a timer, lists the submissions waiting at the
       destination, and starts one `fitconnect-submission` process instance per
       submission (multi-instance call activity). Keeping the per-submission
       work in its own process instance is what lets us later search by caseId
       (see CaseLookupDelegate). -->
  <bpmn:process id="fitconnect-poll" name="FIT-Connect submission poll" isExecutable="true"
                camunda:versionTag="1.0" camunda:historyTimeToLive="P30D">

    <bpmn:startEvent id="StartTimer" name="Every poll interval">
      <bpmn:outgoing>Flow_start_poll</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_poll">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">${pollScheduleConfig.pollCycle}</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_poll" sourceRef="StartTimer" targetRef="PollSubmissions"/>

    <bpmn:serviceTask id="PollSubmissions" name="Poll new submissions"
                      camunda:asyncBefore="true"
                      camunda:delegateExpression="${pollSubmissionsDelegate}">
      <bpmn:incoming>Flow_start_poll</bpmn:incoming>
      <bpmn:outgoing>Flow_poll_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_poll_gw" sourceRef="PollSubmissions" targetRef="Gateway_hasSubmissions"/>

    <bpmn:exclusiveGateway id="Gateway_hasSubmissions" name="New submissions?" default="Flow_gw_handle">
      <bpmn:incoming>Flow_poll_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_gw_none</bpmn:outgoing>
      <bpmn:outgoing>Flow_gw_handle</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_gw_none" name="none" sourceRef="Gateway_hasSubmissions" targetRef="EndEvent_none">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${submissionCount == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="EndEvent_none" name="No new submissions">
      <bpmn:incoming>Flow_gw_none</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_gw_handle" sourceRef="Gateway_hasSubmissions" targetRef="HandleSubmission"/>

    <!-- One `fitconnect-submission` instance per id in submissionRefs; the id is
         passed in as `submissionRef` and also used as the child's business key. -->
    <bpmn:callActivity id="HandleSubmission" name="Handle submission"
                       camunda:asyncBefore="true"
                       calledElement="fitconnect-submission">
      <bpmn:extensionElements>
        <camunda:in businessKey="${submissionRef}"/>
        <camunda:in source="submissionRef" target="submissionRef"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_gw_handle</bpmn:incoming>
      <bpmn:outgoing>Flow_handle_done</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"
                                             camunda:collection="${submissionRefs}"
                                             camunda:elementVariable="submissionRef"/>
    </bpmn:callActivity>

    <bpmn:sequenceFlow id="Flow_handle_done" sourceRef="HandleSubmission" targetRef="EndEvent_done"/>

    <bpmn:endEvent id="EndEvent_done" name="Poll cycle complete">
      <bpmn:incoming>Flow_handle_done</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_fitconnect_poll">
    <bpmndi:BPMNPlane id="BPMNPlane_fitconnect_poll" bpmnElement="fitconnect-poll">

      <bpmndi:BPMNShape id="StartTimer_di" bpmnElement="StartTimer">
        <omgdc:Bounds x="152" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="132" y="185" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PollSubmissions_di" bpmnElement="PollSubmissions">
        <omgdc:Bounds x="240" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_hasSubmissions_di" bpmnElement="Gateway_hasSubmissions" isMarkerVisible="true">
        <omgdc:Bounds x="400" y="135" width="50" height="50"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="390" y="95" width="71" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_none_di" bpmnElement="EndEvent_none">
        <omgdc:Bounds x="407" y="250" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="384" y="293" width="83" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandleSubmission_di" bpmnElement="HandleSubmission">
        <omgdc:Bounds x="520" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_done_di" bpmnElement="EndEvent_done">
        <omgdc:Bounds x="682" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="660" y="185" width="82" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_start_poll_di" bpmnElement="Flow_start_poll">
        <omgdi:waypoint x="188" y="160"/><omgdi:waypoint x="240" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_poll_gw_di" bpmnElement="Flow_poll_gw">
        <omgdi:waypoint x="340" y="160"/><omgdi:waypoint x="400" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_none_di" bpmnElement="Flow_gw_none">
        <omgdi:waypoint x="425" y="185"/><omgdi:waypoint x="425" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_handle_di" bpmnElement="Flow_gw_handle">
        <omgdi:waypoint x="450" y="160"/><omgdi:waypoint x="520" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_handle_done_di" bpmnElement="Flow_handle_done">
        <omgdi:waypoint x="620" y="160"/><omgdi:waypoint x="682" y="160"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
