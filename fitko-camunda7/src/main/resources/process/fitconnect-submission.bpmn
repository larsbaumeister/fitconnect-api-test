<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_fitconnect_submission"
                  targetNamespace="http://gfi.com/ozg/fitko/camunda"
                  exporter="hand-written" exporterVersion="1.0">

  <!-- One instance per submission, started by the `fitconnect-poll` dispatcher.
       Fully automated - no user tasks. Fixed order:
         load all data -> persist -> (only if that succeeded) accept ->
         look up the case -> decide the internal next step (DMN) -> do it.
       If Persist fails it throws: Accept downstream is never reached, the
       submission stays on the delivery service and a later poll cycle retries. -->
  <bpmn:process id="fitconnect-submission" name="FIT-Connect submission handling" isExecutable="true"
                camunda:versionTag="2.0" camunda:historyTimeToLive="P30D">

    <bpmn:startEvent id="SubStart" name="Submission to handle">
      <bpmn:outgoing>Flow_start_load</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_start_load" sourceRef="SubStart" targetRef="LoadSubmission"/>

    <bpmn:serviceTask id="LoadSubmission" name="Load &amp; decrypt submission"
                      camunda:asyncBefore="true"
                      camunda:delegateExpression="${loadSubmissionDelegate}">
      <bpmn:incoming>Flow_start_load</bpmn:incoming>
      <bpmn:outgoing>Flow_load_persist</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_load_persist" sourceRef="LoadSubmission" targetRef="PersistSubmission"/>

    <bpmn:serviceTask id="PersistSubmission" name="Persist submission data"
                      camunda:delegateExpression="${persistSubmissionDelegate}">
      <bpmn:incoming>Flow_load_persist</bpmn:incoming>
      <bpmn:outgoing>Flow_persist_accept</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_persist_accept" sourceRef="PersistSubmission" targetRef="AcceptSubmission"/>

    <bpmn:serviceTask id="AcceptSubmission" name="Accept submission"
                      camunda:delegateExpression="${acceptSubmissionDelegate}">
      <bpmn:incoming>Flow_persist_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_accept_lookup</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_accept_lookup" sourceRef="AcceptSubmission" targetRef="LookupCase"/>

    <bpmn:serviceTask id="LookupCase" name="Look up case"
                      camunda:delegateExpression="${caseLookupDelegate}">
      <bpmn:incoming>Flow_accept_lookup</bpmn:incoming>
      <bpmn:outgoing>Flow_lookup_decide</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_lookup_decide" sourceRef="LookupCase" targetRef="DecideNextStep"/>

    <bpmn:businessRuleTask id="DecideNextStep" name="Decide next step"
                           camunda:decisionRef="next-step-routing"
                           camunda:mapDecisionResult="singleResult"
                           camunda:resultVariable="routing">
      <bpmn:extensionElements>
        <camunda:executionListener event="end"
            expression="${execution.setVariable('nextStep', routing.get('nextStep'))}"/>
        <camunda:executionListener event="end"
            expression="${execution.setVariable('nextStepTarget', routing.get('nextStepTarget'))}"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_lookup_decide</bpmn:incoming>
      <bpmn:outgoing>Flow_decide_gw</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_decide_gw" sourceRef="DecideNextStep" targetRef="Gateway_nextStep"/>

    <bpmn:exclusiveGateway id="Gateway_nextStep" name="nextStep" default="Flow_next_archive">
      <bpmn:incoming>Flow_decide_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_next_forward</bpmn:outgoing>
      <bpmn:outgoing>Flow_next_archive</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_next_forward" name="FORWARD" sourceRef="Gateway_nextStep" targetRef="ForwardToFachverfahren">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nextStep == "FORWARD"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_next_archive" name="else (ARCHIVE)" sourceRef="Gateway_nextStep" targetRef="ArchiveSubmission"/>

    <bpmn:serviceTask id="ForwardToFachverfahren" name="Forward to Fachverfahren"
                      camunda:delegateExpression="${forwardSubmissionDelegate}">
      <bpmn:incoming>Flow_next_forward</bpmn:incoming>
      <bpmn:outgoing>Flow_forward_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ArchiveSubmission" name="Archive submission"
                      camunda:delegateExpression="${archiveSubmissionDelegate}">
      <bpmn:incoming>Flow_next_archive</bpmn:incoming>
      <bpmn:outgoing>Flow_archive_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_forward_end" sourceRef="ForwardToFachverfahren" targetRef="SubEnd"/>
    <bpmn:sequenceFlow id="Flow_archive_end" sourceRef="ArchiveSubmission" targetRef="SubEnd"/>

    <bpmn:endEvent id="SubEnd" name="Submission handled">
      <bpmn:incoming>Flow_forward_end</bpmn:incoming>
      <bpmn:incoming>Flow_archive_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_fitconnect_submission">
    <bpmndi:BPMNPlane id="BPMNPlane_fitconnect_submission" bpmnElement="fitconnect-submission">

      <bpmndi:BPMNShape id="SubStart_di" bpmnElement="SubStart">
        <omgdc:Bounds x="152" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="132" y="225" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LoadSubmission_di" bpmnElement="LoadSubmission">
        <omgdc:Bounds x="230" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PersistSubmission_di" bpmnElement="PersistSubmission">
        <omgdc:Bounds x="380" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AcceptSubmission_di" bpmnElement="AcceptSubmission">
        <omgdc:Bounds x="530" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LookupCase_di" bpmnElement="LookupCase">
        <omgdc:Bounds x="680" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DecideNextStep_di" bpmnElement="DecideNextStep">
        <omgdc:Bounds x="830" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_nextStep_di" bpmnElement="Gateway_nextStep" isMarkerVisible="true">
        <omgdc:Bounds x="985" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="982" y="151" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ForwardToFachverfahren_di" bpmnElement="ForwardToFachverfahren">
        <omgdc:Bounds x="1090" y="90" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveSubmission_di" bpmnElement="ArchiveSubmission">
        <omgdc:Bounds x="1090" y="230" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubEnd_di" bpmnElement="SubEnd">
        <omgdc:Bounds x="1262" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><omgdc:Bounds x="1240" y="225" width="82" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_start_load_di" bpmnElement="Flow_start_load">
        <omgdi:waypoint x="188" y="200"/><omgdi:waypoint x="230" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_load_persist_di" bpmnElement="Flow_load_persist">
        <omgdi:waypoint x="330" y="200"/><omgdi:waypoint x="380" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_persist_accept_di" bpmnElement="Flow_persist_accept">
        <omgdi:waypoint x="480" y="200"/><omgdi:waypoint x="530" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_accept_lookup_di" bpmnElement="Flow_accept_lookup">
        <omgdi:waypoint x="630" y="200"/><omgdi:waypoint x="680" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_lookup_decide_di" bpmnElement="Flow_lookup_decide">
        <omgdi:waypoint x="780" y="200"/><omgdi:waypoint x="830" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_decide_gw_di" bpmnElement="Flow_decide_gw">
        <omgdi:waypoint x="930" y="200"/><omgdi:waypoint x="985" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_next_forward_di" bpmnElement="Flow_next_forward">
        <omgdi:waypoint x="1010" y="175"/><omgdi:waypoint x="1010" y="130"/><omgdi:waypoint x="1090" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_next_archive_di" bpmnElement="Flow_next_archive">
        <omgdi:waypoint x="1010" y="225"/><omgdi:waypoint x="1010" y="270"/><omgdi:waypoint x="1090" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_forward_end_di" bpmnElement="Flow_forward_end">
        <omgdi:waypoint x="1190" y="130"/><omgdi:waypoint x="1230" y="130"/>
        <omgdi:waypoint x="1230" y="200"/><omgdi:waypoint x="1262" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_archive_end_di" bpmnElement="Flow_archive_end">
        <omgdi:waypoint x="1190" y="270"/><omgdi:waypoint x="1230" y="270"/>
        <omgdi:waypoint x="1230" y="200"/><omgdi:waypoint x="1262" y="200"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
