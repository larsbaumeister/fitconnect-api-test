<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

  <!-- Standalone in-memory engine for the process/DMN integration tests
       (camunda-bpm-junit5 ProcessEngineExtension picks this up). -->
  <bean id="processEngineConfiguration"
        class="org.camunda.bpm.engine.impl.cfg.StandaloneInMemProcessEngineConfiguration">

    <property name="jdbcUrl" value="jdbc:h2:mem:camunda-fitconnect-test;DB_CLOSE_DELAY=1000"/>
    <property name="databaseSchemaUpdate" value="true"/>
    <property name="jobExecutorActivate" value="false"/>
    <property name="history" value="full"/>

    <!-- Resolve ${...} delegate references to objects registered via
         org.camunda.bpm.engine.test.mock.Mocks in the tests. -->
    <property name="expressionManager">
      <bean class="org.camunda.bpm.engine.test.mock.MockExpressionManager"/>
    </property>
  </bean>

</beans>
