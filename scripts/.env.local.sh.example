# Real credentials for scripts/send.sh and scripts/receive.sh.
#
#   cp scripts/.env.local.sh.example scripts/.env.local.sh
#   "$EDITOR" scripts/.env.local.sh
#
# scripts/.env.local.sh is gitignored - it never gets committed - and is
# sourced automatically by both scripts if it exists, so real secrets never
# have to touch a tracked file. Leave any variable empty/unset here to fall
# back to whatever's already exported in your shell.

export FITCONNECT_SENDER_CLIENT_ID=""
export FITCONNECT_SENDER_CLIENT_SECRET=""
export FITCONNECT_RECEIVER_CLIENT_ID=""
export FITCONNECT_RECEIVER_CLIENT_SECRET=""
export FITCONNECT_DESTINATION_ID=""
