<?xml version="1.0" encoding="UTF-8"?>
<!-- The inbox: one inbox_submission row per FIT-Connect submission this
     application has taken on. AntragHandler writes it BEFORE starting the
     process, so the primary key doubles as the de-duplication check for a
     re-delivered submission, and every later step (process started, accepted,
     rejected) is recorded here before the next one runs - see InboxStatus.

     Deliberately no submission content (payload, metadata, attachments,
     reply key): this application only hands the submission over to the
     process. Stored is what identifies it, where it went and what happened
     to it. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-inbox-submission" author="fitko-spring-ihk">
        <createTable tableName="inbox_submission">
            <!-- which submission, and the routing input: where it came in
                 (destination -> tenant) and which Leistung it is -->
            <column name="submission_id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_inbox_submission"/>
            </column>
            <column name="case_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="destination_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="tenant" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="service_identifier" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="received_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>

            <!-- life cycle: RECEIVED, PROCESS_STARTED, ACCEPTED,
                 REJECTION_PENDING, REJECTED (InboxStatus) -->
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <!-- process start attempts; last_error = why the last attempt at
                 any step failed -->
            <column name="attempts" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="varchar(2000)"/>
            <column name="process_starter_class" type="varchar(500)"/>

            <!-- which process was started, and when (from PROCESS_STARTED on) -->
            <column name="process_definition" type="varchar(255)"/>
            <column name="process_instance_id" type="varchar(255)"/>
            <column name="process_started_at" type="timestamp with time zone"/>

            <!-- why it was rejected (from REJECTION_PENDING on): the
                 ProcessStarter's reason, and the FIT-Connect problems sent
                 with the rejection as a JSON array - kept so that a failed
                 rejection is repeated with the same problems -->
            <column name="rejection_reason" type="varchar(2000)"/>
            <column name="rejection_problems" type="text"/>

            <!-- when FIT-Connect confirmed the accept/reject -->
            <column name="resolved_at" type="timestamp with time zone"/>

            <column name="lock_version" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="inbox_submission" indexName="ix_inbox_submission_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
