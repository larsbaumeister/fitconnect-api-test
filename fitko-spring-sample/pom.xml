<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- A normal Spring Boot application. The only FIT-Connect-specific line
       in this whole file is the `fitko-spring` dependency below; everything
       else is a stock `spring-boot-starter-*`. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>fitko-spring-sample</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>fitko-spring-sample</name>
  <description>
    Reference Spring Boot application showing how to integrate the
    fitko-spring starter: sending an Antrag through an injected AntragSender,
    and receiving Antraege as Spring application events.
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- ===================================================================
         THE integration point. Pulls in the FIT-Connect Java SDK and the
         auto-configuration that turns `fitconnect.*` properties into an
         `AntragSender` bean plus an `AntragReceivedEvent` per submission.

         Not on Maven Central yet - build it into your local ~/.m2 first:
             cd ../fitko-spring && mvn install
         (see README.md "Prerequisites").
         =================================================================== -->
    <dependency>
      <groupId>com.gfi.ozg.fitko</groupId>
      <artifactId>fitko-spring</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- REST endpoints that trigger a send / list what was received. Also
         what the optional FIT-Connect callback webhook endpoint needs on the
         classpath - see application.yaml `fitconnect.receiver.callback`. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Optional but recommended for the receive side: brings Micrometer and
         the Actuator health API onto the classpath, which is all it takes
         for fitko-spring to start publishing `fitconnect.receive.*` meters
         and a `fitConnectReceiver` health contributor. Without this
         dependency the starter simply doesn't register either - no code
         change, no error. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Just for @Valid on the send request DTO; nothing FIT-Connect-specific. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
